{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura Clipboard",
  "version": "0.1.0",
  "identifier": "dev.aura.clipboard",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Aura Clipboard",
    "homepage": "https://github.com/yahgos/aura-clipboard",
    "category": "Utility",
    "shortDescription": "Shared clipboard for the computers on your LAN",
    "longDescription": "Copy on one computer, paste on any other on the same network. Peer-to-peer and end-to-end encrypted, no server or account.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
